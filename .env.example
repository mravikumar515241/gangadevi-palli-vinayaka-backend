# ==============================
# Local / Production Environment
# ==============================

# Spring profile: local or prod
SPRING_PROFILES_ACTIVE=local

# Server
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vinayaka
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
# Optional legacy/override form:
# DB_URL=jdbc:postgresql://localhost:5432/vinayaka

# Hikari connection pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# JWT - use a strong random secret in production
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600

# Admin - production must use a strong password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Swagger/OpenAPI
SWAGGER_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Gallery limits
GALLERY_MAX_FILE_SIZE_BYTES=10485760
GALLERY_MAX_FILE_SIZE=10MB
GALLERY_MAX_REQUEST_SIZE=12MB
